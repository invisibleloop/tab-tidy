{
  "manifest_version": 3,
  "name": "Tab Tidy",
  "version": "1.0.0",
  "description": "Automatically group open tabs into named tab groups based on URL match rules.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
